ldc_set_port -iobuf {IO_TYPE=LVCMOS18} [get_ports spi0_mosi]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18} [get_ports spi0_sck]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18} [get_ports spi0_miso]
