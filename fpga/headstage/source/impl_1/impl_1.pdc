ldc_set_port -iobuf {DRIVE=8 GLITCHFILTER=OFF HYSTERESIS=NA PULLMODE=NONE SLEWRATE=MED IO_TYPE=LVCMOS18} [get_ports cmd_is_00]
ldc_set_location -site {G8} [get_ports clkin]
