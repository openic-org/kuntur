	(text_box "VSS=GND (Logic+IO)\nVSSA_DPHY=GND (AGND for DPHY blocks)\nVSSSD=GND (SerDes)\nVCC= (Core Logic)\nVCCAUXA=1.8V nom.(Aux Supply for internal Analog)\nVCCAUX=1.8V nom. (Aux Supply for IO Bank0/1/2/6/7 used for generating stable drive current for IO)\nVCCAUXHx=1.8V nom. (Aux Supply for IO Bank3/4/5 used for generating stable current for the differential input comparators)\nVCCIOx= Supply for IO Bank x (for x=0,1,2,6,7, VCCIO can be 1.2/1.5/1.8/2.5/3.3 V)\n                               (for x=3,4,5, VCCIO can be 1.0/1.2/1.35/1.5/1.8 V)\nVCCDPHY=1.0V nom. (supply for DPHY block)\nVCCADPHY=1.8V nom. (analog supply for DPHY block)\nVCCPLLDPHY=1.0V nom. (supply for DPHY block)"
		(exclude_from_sim no)
		(at 15.24 165.1 0)
		(size 88.9 30.48)
		(stroke
